<Window x:Class="mercado.View.EditarCarrinhoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:mercado.View"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:localBehaviors="clr-namespace:mercado.Behaviors"
        mc:Ignorable="d"
        Title="Editar Carrinho" Height="450" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#fcf8f2">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Editar Itens do Carrinho" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="dgCarrinho" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,10" CellEditEnding="DataGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Produto" Binding="{Binding Produto.Nome}" Width="*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Qtd" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Quantidade}" TextAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Quantidade, UpdateSourceTrigger=LostFocus}" FontSize="14"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="V. Unit. (R$)" Binding="{Binding ValorUnitario, StringFormat={}{0:N2}}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Subtotal (R$)" Binding="{Binding Subtotal, StringFormat={}{0:N2}}" Width="100" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Desconto (R$)" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Desconto, StringFormat={}{0:N2}}" TextAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Desconto, UpdateSourceTrigger=LostFocus}" FontSize="14"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ação" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Excluir" Background="#E74C3C" Foreground="White" FontWeight="Bold" Click="BtnExcluir_Click" Tag="{Binding}" Height="22" Width="80"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="Salvar" Height="35" Width="100" Background="#27AE60" Foreground="White" FontWeight="Bold" Margin="0,0,5,0" Click="BtnSalvar_Click"/>
            <Button Content="Cancelar" Height="35" Width="100" Background="#E74C3C" Foreground="White" FontWeight="Bold" Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
