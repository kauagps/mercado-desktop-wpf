<UserControl x:Class="mercado.View.EstoqueView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:mercado.View"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:localBehaviors="clr-namespace:mercado.Behaviors" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--=========================================================================================================================-->
        <!-- CONTAINER Cadastrar PRODUTOS -->
        <!--==============================-->
        <Border Grid.Row="0" Background="LightGray" CornerRadius="5" Padding="10" Margin="0, 0, 0, 20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
    
                
                <!--Titulo-->
                <TextBlock Grid.Row="0" Text="Cadastrar Produto" FontSize="16" FontWeight="Bold" Margin="0, 0, 0, 10"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0, 0, 0, 20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0, 0, 0, 20">
                            <TextBlock Text="* Nome do Produto:" VerticalAlignment="Center" Margin="0, 0, 10, 0"/>
                            <TextBox Width="250" Margin="0, 0, 10, 0"
                                 Text="{Binding NovoProduto.Nome, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nome do produto">
                            </TextBox>
                        </StackPanel>

                        <!--Codigo de Barras-->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0, 0, 0, 20">
                            <TextBlock Text="Código de Barras:" VerticalAlignment="Center" Margin="0, 0, 10, 0"/>
                            <TextBox x:Name="txtCodigoBarras"
                                 Width="250" Margin="0, 0, 10, 0"
                                 Text="{Binding NovoProduto.CodigoBarras}"
                                 KeyDown="txtCodigoBarras_KeyDown"
                                 ToolTip="Código de Barras do produto">
                            </TextBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>


                <!--Custo, Lucro e Valor de Venda do Produto-->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0, 0, 0, 20">
                    
                    <!-- Custo -->
                    <TextBlock Text="Custo: (R$)" VerticalAlignment="Center" Margin="0, 0, 10, 0"/>
                    <TextBox x:Name="txtCusto"
                             Width="80" 
                             Margin="0, 0, 10, 0"
                             Text="{Binding NovoProduto.Custo, StringFormat={}{0:N2}}"
                             TextChanged="CalcularPrecoIdeal_TextChanged"
                             ToolTip="Custo">
                        <i:Interaction.Behaviors>
                            <localBehaviors:ApenasNumerosBehavior>
                            </localBehaviors:ApenasNumerosBehavior>
                        </i:Interaction.Behaviors>
                    </TextBox>
                    
                    <!--Lucro-->
                    <TextBlock Text="Lucro: (%)" VerticalAlignment="Center" Margin="0, 0, 10, 0"/>
                    <TextBox x:Name="txtLucro"
                             Width="80" 
                             Margin="0, 0, 10, 0"
                             Text="{Binding NovoProduto.Lucro, StringFormat={}{0:N2}}"
                             TextChanged="CalcularPrecoIdeal_TextChanged"
                             ToolTip="Lucro">
                        <i:Interaction.Behaviors>
                            <localBehaviors:ApenasNumerosBehavior>
                            </localBehaviors:ApenasNumerosBehavior>
                        </i:Interaction.Behaviors>
                    </TextBox>
                    
                    <!--Valor de Venda-->
                    <TextBlock Text="Valor de Venda: (R$)" VerticalAlignment="Center" Margin="0, 0, 10, 0"/>
                    <TextBox Width="80" Margin="0, 0, 10, 0"
                             Text="{Binding NovoProduto.ValorVenda, StringFormat={}{0:N2}}"
                             ToolTip="Valor de Venda">
                        <i:Interaction.Behaviors>
                            <localBehaviors:ApenasNumerosBehavior>
                            </localBehaviors:ApenasNumerosBehavior>
                        </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock x:Name="tbPrecoIdeal"
                        Text="Valor recomendado: (R$) 0,00" 
                        FontWeight="Bold" 
                        Foreground="Green" 
                        VerticalAlignment="Center" 
                        Margin="15, 0, 0, 0"/>
                </StackPanel>
                
                <!--Quantidade Minima e Venda Fracionada do Produto-->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0, 0, 0, 20">

                    <!--Quantidade Minima-->
                    <TextBlock Text="Quantidade Mínima no Estoque:" VerticalAlignment="Center" Margin="0, 0, 10, 0"/>
                    <TextBox x:Name="txtQuantidadeMin"
                             Width="80"
                             Tag="{Binding IsChecked, ElementName=chkFracionado}"
                             Text="{Binding NovoProduto.QuantidadeMin}"
                             Margin="0, 0, 10, 0"
                             ToolTip="Quantidade Mínima">
                        <i:Interaction.Behaviors>
                            <localBehaviors:NumeroFracionadoBehavior />
                        </i:Interaction.Behaviors>
                    </TextBox>

                    <!--Quantidade Atual-->
                    <TextBlock Text="Quantidade Atual no Estoque:" VerticalAlignment="Center" Margin="0, 0, 10, 0"/>
                    <TextBox x:Name="txtQuantidadeAtual"
                             Width="80"
                             Tag="{Binding IsChecked, ElementName=chkFracionado}"
                             Text="{Binding NovoProduto.QuantidadeAtual}"
                             Margin="0, 0, 10, 0"
                             ToolTip="Quantidade Atual">
                        <i:Interaction.Behaviors>
                            <localBehaviors:NumeroFracionadoBehavior />
                        </i:Interaction.Behaviors>
                    </TextBox>

                    <!--Fracionado-->
                    <CheckBox x:Name="chkFracionado"
                              Click="chkFracionado_Click"
                              Content="Venda Fracionada (Ex: Kg)" 
                              IsChecked="{Binding NovoProduto.Fracionado, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0, 0, 10, 0" 
                              VerticalAlignment="Center">
                    </CheckBox>
                </StackPanel>
                
                <!--Produto Ativo e Botão Adicionar Produto-->
                <Grid Grid.Row="4" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!--Product Ativo Checkbox-->
                    <CheckBox Content="Produto Ativo" Margin="0, 0, 30, 0" 
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              IsChecked="{Binding NovoProduto.Ativo}">
                    </CheckBox>
                    
                    <!--Botao Adicionar Produto-->
                    <Button Content="Adicionar Produto" Width="180" 
                            HorizontalAlignment="Right"
                            Command="{Binding AdicionarProdutoCommand}"></Button>
                </Grid>
            </Grid>
        </Border>

        <!--======================================================================================================================================-->
        <!-- CONTAINER TABELA DE PRODUTOS -->
        <!--==============================-->
        <Grid Grid.Row="1" Margin="0, 20, 0, 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0, 0, 0, 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Tabela de Produtos" FontSize="16" FontWeight="Bold" Margin="0, 0, 0, 10"/>

                <!--Campo Buscar Produto-->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 0, 0, 10">
                    <TextBlock Text="Buscar Produto: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0, 0, 10, 0"/>

                    <TextBox Width="250" Padding="5"
                         Text="{Binding TextoBusca, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Digite o nome do produto para buscar"/>
                </StackPanel>
            </Grid>

            <!--Tabela de Produtos-->
            <DataGrid Grid.Row="1" ItemsSource="{Binding ProdutosLista}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>

                    <!--Colunas Nome, Custo, Lucro, Valor de Venda, Quantidade Minima e Ativo-->
                    <DataGridTextColumn Header="Cod. Barras" Binding="{Binding CodigoBarras}" Width="60" />
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                    <DataGridTextColumn Header="Custo (R$)" Binding="{Binding Custo, StringFormat={}{0:N2}}" Width="130" />
                    <DataGridTextColumn Header="Lucro (R$)" Binding="{Binding Lucro, StringFormat={}{0:N2}}" Width="130" />
                    <DataGridTextColumn Header="Venda (R$)" Binding="{Binding ValorVenda, StringFormat={}{0:N2}}" Width="130" />
                    <DataGridTextColumn Header="Qtd. Mínima" Binding="{Binding QuantidadeMin}" Width="130" />
                    <DataGridTextColumn Header="Qtd. Atual" Binding="{Binding QuantidadeAtual}" Width="130" />
                    <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="60" />

                    <DataGridTemplateColumn Header="Ações" Width="300">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <!--Botoes-->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <!--Editar-->
                                    <Button Content="Editar" Width="70" Margin="2" Background="LightBlue"
                                    Command="{Binding DataContext.EditarProdutoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                    CommandParameter="{Binding}" />

                                    <!--Inativar-->
                                    <Button Content="Inativar" Width="80" Margin="2" Background="LightYellow" Foreground="Gray"
                                    Command="{Binding DataContext.InativarProdutoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                    CommandParameter="{Binding}"
                                    ToolTipService.ShowOnDisabled="True">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="IsEnabled" Value="{Binding Ativo}"/>
                                                <Setter Property="ToolTip" Value="Inativar este Produto"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                        <Setter Property="ToolTip" Value="Produto já está inativo"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!--Excluir-->
                                    <Button Content="Excluir" Width="75" Margin="2" Background="LightCoral"
                                    Command="{Binding DataContext.ExcluirProdutoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                    CommandParameter="{Binding}" />

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
            
            <!--Rodape com paginação-->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 15, 0, 0">

                <TextBlock Text="{Binding TotalItens, StringFormat='{}Total no banco: {0} itens'}" 
                   VerticalAlignment="Center" 
                   Margin="0,0,30,0" 
                   FontWeight="SemiBold" 
                   Foreground="Gray"/>
                
                <TextBlock Text="Itens por página: " VerticalAlignment="Center" Margin="0,0,10,0"/>
                
                <ComboBox ItemsSource="{Binding OpcoesItensPorPagina}"
                          SelectedItem="{Binding ItensPorPagina, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Width="60" Margin="0,0,20,0" VerticalContentAlignment="Center"/>
                
                <Button Content="&lt; Anterior" Command="{Binding PaginaAnteriorCommand}" Width="80" Margin="0,0,10,0"/>

                <TextBlock Text="{Binding PaginaAtual, StringFormat='{}Página {0} de '}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalPaginas}" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold"/>
                
                <Button Content="Próxima &gt;" Command="{Binding ProximaPaginaCommand}" Width="80"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
