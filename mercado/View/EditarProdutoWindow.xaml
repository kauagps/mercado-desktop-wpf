<Window x:Class="mercado.View.EditarProdutoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mercado.View"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:localBehaviors="clr-namespace:mercado.Behaviors" 
        mc:Ignorable="d"
        Title="Editar Produto" Height="550" Width="450">
    <Grid Margin="20">
        
        <!--========================================================================================================-->
        <!--Formulario de Edição de Produto-->
        <!--===============================-->
        <StackPanel>
            
            <!--Titulo-->
            <TextBlock Text="Editar Produto" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
            
            <!--Nome do Produto-->
            <TextBlock Text="Nome do Produto:"/>
            <TextBox Text="{Binding Nome}" Margin="0,0,0,10" Padding="2"/>
            
            <!--Codigo de Barras-->
            <TextBlock Text="Código de Barras:"/>
            <TextBox x:Name="txtCodigoBarras"
                Text="{Binding CodigoBarras}" 
                KeyDown="txtCodigoBarras_KeyDown"
                Margin="0,0,0,10" Padding="2"/>

            <!--Custo-->
            <TextBlock Text="Custo (R$):"/>
            <TextBox x:Name="txtCusto" 
                     Text="{Binding Custo, StringFormat={}{0:N2}}" 
                     TextChanged="CalcularPrecoIdeal_TextChanged"
                     Margin="0,0,0,10" 
                     Padding="2">
                <i:Interaction.Behaviors>
                    <localBehaviors:ApenasNumerosBehavior>
                    </localBehaviors:ApenasNumerosBehavior>
                </i:Interaction.Behaviors>
            </TextBox>

            <!--Lucro-->
            <TextBlock Text="Lucro (%):"/>
            <TextBox x:Name="txtLucro" 
                     Text="{Binding Lucro, StringFormat={}{0:N2}}" 
                     TextChanged="CalcularPrecoIdeal_TextChanged"
                     Margin="0,0,0,10" 
                     Padding="2">
                <i:Interaction.Behaviors>
                    <localBehaviors:ApenasNumerosBehavior>
                    </localBehaviors:ApenasNumerosBehavior>
                </i:Interaction.Behaviors>
            </TextBox>

            <TextBlock x:Name="tbPrecoIdeal"
            Text="Valor recomendado: (R$) 0,00" 
            FontWeight="Bold" 
            Foreground="Green" 
            VerticalAlignment="Center" 
            Margin="0, 0, 0, 10"/>

            <!--Valor de Venda-->
            <TextBlock Text="Valor de Venda (R$):"/>
            <TextBox Text="{Binding ValorVenda, StringFormat={}{0:N2}}" Margin="0,0,0,10" Padding="2">
                <i:Interaction.Behaviors>
                    <localBehaviors:ApenasNumerosBehavior>
                    </localBehaviors:ApenasNumerosBehavior>
                </i:Interaction.Behaviors>
            </TextBox>

            <!--Quantidade Minima-->
            <TextBlock Text="Quantidade Minima:"/>
            <TextBox x:Name="txtQuantidadeMin" 
                     Tag="{Binding IsChecked, ElementName=chkFracionado}"
                     Text="{Binding QuantidadeMin}" 
                     Margin="0,0,0,10" 
                     Padding="2">
                <i:Interaction.Behaviors>
                    <localBehaviors:NumeroFracionadoBehavior />
                </i:Interaction.Behaviors>
            </TextBox>
            
            <!--Quantidade Atual-->
            <TextBlock Text="Quantidade Atual:"/>
            <TextBox x:Name="txtQuantidadeAtual" 
                     Tag="{Binding IsChecked, ElementName=chkFracionado}"
                     Text="{Binding QuantidadeAtual}" 
                     Margin="0,0,0,10" 
                     Padding="2">
                <i:Interaction.Behaviors>
                    <localBehaviors:NumeroFracionadoBehavior />
                </i:Interaction.Behaviors>
            </TextBox>

            <!--Fracionado-->
            <CheckBox x:Name="chkFracionado"
              Click="chkFracionado_Click"
              Content="Venda Fracionada (Ex: Kg)" 
              IsChecked="{Binding Fracionado, UpdateSourceTrigger=PropertyChanged}"
              Margin="0, 0, 10, 0" 
              VerticalAlignment="Center">
            </CheckBox>

            <!--Ativo-->
            <CheckBox Content="Produto Ativo" Margin="0, 0, 30, 0" 
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              IsChecked="{Binding Ativo}">
            </CheckBox>

            
            <!--Cancelar ou Salvar Alterações-->
            <Grid HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancelar" Margin="0,0,5,0" Padding="5" Click="btnCancelar_Click" Background="Red" />
                <Button Grid.Column="1" Content="Salvar Alterações" Margin="5,0,0,0" Padding="5" Click="btnSalvar_Click" Background="LightGreen" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
