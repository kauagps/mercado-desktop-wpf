<Window x:Class="mercado.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mercado.View"
        mc:Ignorable="d"
        Title="Login - Sistema Mercado" Height="600" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#fcf8f2"
        Style="{StaticResource MaterialDesignWindow}"
        KeyDown="Window_KeyDown">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo/Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30" HorizontalAlignment="Center">
            <TextBlock Text="🏪" FontSize="48" HorizontalAlignment="Center"/>
            <TextBlock Text="Sistema Mercado" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="Faça login para continuar" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Formulário -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Usuário -->
            <TextBlock Text="Usuário" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsuario"
                     Margin="0,0,0,15"
                     Padding="10"
                     FontSize="14"
                     ToolTip="Digite seu nome de usuário"/>

            <!-- Senha -->
            <TextBlock Text="Senha" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtSenha"
                         Margin="0,0,0,20"
                         Padding="10"
                         FontSize="14"
                         KeyDown="txtSenha_KeyDown"
                         ToolTip="Digite sua senha"/>

            <!-- Botão Entrar -->
            <Button x:Name="btnEntrar"
                    Content="ENTRAR"
                    Height="45"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#2C3E50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnEntrar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Mensagem de erro -->
            <TextBlock x:Name="txtErro"
                       Text=""
                       Foreground="Red"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,15,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Rodapé -->
        <TextBlock Grid.Row="2"
                   Text="Sistema Mercado"
                   FontSize="12"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"/>
    </Grid>
</Window>