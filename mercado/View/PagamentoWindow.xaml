<Window x:Class="mercado.View.PagamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mercado.View"
        mc:Ignorable="d"
        Title="Finalizar Pagamento" Height="650" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F6F8">
    

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="5" Opacity="0.2" BlurRadius="10"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Formas de Pagamento" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>

                <!-- Botões de Seleção -->
                <UniformGrid Rows="2" Columns="2" Height="100" Margin="0,0,0,20">
                    <Button Content="Dinheiro" x:Name="btnDinheiro" Margin="5" Background="#E3F2FD" Foreground="Black" Click="SelecionarFormaPagamento_Click"/>
                    <Button Content="Pix" x:Name="btnPix" Margin="5" Background="#E8F5E9" Foreground="Black" Click="SelecionarFormaPagamento_Click"/>
                    <Button Content="Cartão de Crédito" x:Name="btnCredito" Margin="5" Background="#FFF3E0" Foreground="Black" Click="SelecionarFormaPagamento_Click"/>
                    <Button Content="Cartão de Débito" x:Name="btnDebito" Margin="5" Background="#FCE4EC" Foreground="Black" Click="SelecionarFormaPagamento_Click"/>
                </UniformGrid>

                <TextBlock Text="Forma Selecionada:" Foreground="Gray"/>
                <TextBlock x:Name="txtFormaSelecionada" Text="Dinheiro" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="Valor a Pagar (R$):" Foreground="Gray"/>
                <TextBox x:Name="txtValorPagamento" FontSize="24" FontWeight="Bold" Margin="0,0,0,15" Padding="5" 
                         Text="{Binding FaltaPagar, StringFormat={}{0:N2}, Mode=OneWay}" KeyDown="txtValorPagamento_KeyDown"/>

                <Button Content="ADICIONAR PAGAMENTO (Enter)" Height="45" Background="#2196F3" Foreground="White" 
                        FontWeight="Bold" FontSize="16" Click="AdicionarPagamento_Click"/>

                <!-- Lista de pagamentos já inseridos -->
                <DataGrid ItemsSource="{Binding Pagamentos}" AutoGenerateColumns="False" IsReadOnly="True" 
                          Height="100" Margin="0,20,0,0" HeadersVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding FormaPagamento}" Width="*" />
                        <DataGridTextColumn Binding="{Binding ValorPago, StringFormat={}{0:N2}}" Width="100" />

                        <DataGridTemplateColumn Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="X" Background="#EF5350" Foreground="White" FontWeight="Bold" Width="Auto"
                                        BorderThickness="0" Cursor="Hand" Click="RemoverPagamento_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

        </Border>

        <Border Grid.Column="1" Background="#2C3E50" CornerRadius="8" Padding="30" Margin="10,0,0,0">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Total da Compra:" FontSize="18" Foreground="#BDBDBD"/>
                <TextBlock Text="{Binding TotalCompra, StringFormat='{}R$ {0:N2}'}" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                <TextBlock Text="Total Pago:" FontSize="18" Foreground="#BDBDBD"/>
                <TextBlock Text="{Binding TotalPago, StringFormat='{}R$ {0:N2}'}" FontSize="30" FontWeight="SemiBold" Foreground="#81C784" Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Falta Pagar:" FontSize="16" Foreground="#BDBDBD"/>
                        <TextBlock Text="{Binding FaltaPagar, StringFormat='{}R$ {0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#EF5350"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Troco:" FontSize="16" Foreground="#BDBDBD"/>
                        <TextBlock Text="{Binding Troco, StringFormat='{}R$ {0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#64B5F6"/>
                    </StackPanel>
                </Grid>

                <Button Content="FINALIZAR VENDA" Height="60" Background="#4CAF50" Foreground="White" 
                        FontSize="22" FontWeight="Black" Margin="0,20,0,0" Click="FinalizarVenda_Click"/>
            </StackPanel>
        </Border>
    </Grid>
        
</Window>
