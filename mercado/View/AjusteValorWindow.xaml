<Window x:Class="mercado.View.AjusteValorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mercado.View"
        mc:Ignorable="d"
        
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:localBehaviors="clr-namespace:mercado.Behaviors" 
        
        
        Title="Ajuste de Valor" Height="220" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#fcf8f2">

    <StackPanel>

        <!-- O título que vai mudar (Ex: "Informe o Desconto") -->
        <TextBlock x:Name="lblMensagem" Text="Informe o valor:" 
                   FontSize="18" FontWeight="Bold" Foreground="#2C3E50" 
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- A caixa onde o operador digita -->
        <TextBox x:Name="txtValor" FontSize="24" FontWeight="Bold" 
                 HorizontalContentAlignment="Center" Padding="5" Margin="0,0,0,20"
                 KeyDown="txtValor_KeyDown" >

            <i:Interaction.Behaviors>
                <localBehaviors:ApenasNumerosBehavior>
                </localBehaviors:ApenasNumerosBehavior>
            </i:Interaction.Behaviors>
        </TextBox>

        <!-- Botões -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="ENTER - Confirmar" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" 
                    Height="40" Margin="0,0,5,0" Cursor="Hand" Click="btnConfirmar_Click"/>

            <Button Grid.Column="1" Content="ESC - Cancelar" 
                    Background="#E74C3C" Foreground="White" FontWeight="Bold" 
                    Height="40" Margin="5,0,0,0" Cursor="Hand" Click="btnCancelar_Click"/>
        </Grid>
    </StackPanel>
</Window>
