<UserControl x:Class="mercado.View.PdvView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:mercado.View"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:localBehaviors="clr-namespace:mercado.Behaviors" 
      mc:Ignorable="d" 
      Background="White">


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0, 0, 0, 10">
            <Button Content="(F2) - Buscar Produto" Height="35" Width="auto" Margin="0,10,0,0" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold" Background="Aqua" Click="BuscarProduto_Click"
                    ToolTip="Buscar Produto (F2 ou Ctrl+P)"/>
            <Button Content="(F10) - Desconto" Height="35" Width="auto" Margin="10,10,0,0" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold" Background="Aqua" Click="btnDesconto_Click"
                    ToolTip="Desconto Global (F10)"/>
            <Button Content="(+) - Acréscimo" Height="35" Width="auto" Margin="10,10,0,0" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold" Background="#FF9800" Click="btnAcrescimo_Click"
                    ToolTip="Acréscimo Global (Tecla +)"/>
            <Button Content="(F3) - Editar Carrinho" Height="35" Width="auto" Margin="10,10,0,0" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold" Background="#FF9800" Click="btnEditarCarrinho_Click"
                    ToolTip="Editar Carrinho (F3 ou Ctrl+A)"/>
            <Button Content="(Ctrl+Del) - Excluir Último" Height="35" Width="auto" Margin="10,10,0,0" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold" Background="#E74C3C" Foreground="White" Click="btnExcluirUltimo_Click"
                    ToolTip="Excluir Último Item do Carrinho (Ctrl+Del)"/>
            <Button Content="(F8) - Quantidade" Height="35" Width="auto" Margin="10,10,0,0" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold" Background="#3498DB" Foreground="White" Click="btnFocarQuantidade_Click"
                    ToolTip="Focar Campo Quantidade (F8)"/>
        </StackPanel>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"></ColumnDefinition>
                <ColumnDefinition Width="4*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Margin="10,0,0,0" Background="#f8f9fa" CornerRadius="8" Padding="20">
                <StackPanel >
                    <TextBlock Text="PONTO DE VENDA" FontSize="22" FontWeight="Black" Margin="0,0,0,20" Foreground="#2c3e50" />

                    <!-- O multiplicador de quantidade -->
                    <TextBlock Margin="0,0,0,5">
                        <Run Text="Quantidade:" FontWeight="Bold" FontSize="16" Foreground="#2c3e50" />
                        <Run Text="(Unidade / Kg)" FontSize="12" Foreground="Gray" />
                    </TextBlock>
                    <TextBox x:Name="txtQuantidade" Text="{Binding QuantidadeAtual}" FontSize="20" FontWeight="Bold" HorizontalContentAlignment="Center" Margin="0,0,0,15" Padding="5">
                        <i:Interaction.Behaviors>
                            <localBehaviors:ApenasNumerosBehavior>
                            </localBehaviors:ApenasNumerosBehavior>
                        </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock Text="Para seguir para leitura de codigo do produto, aperte TAB" FontSize="12" Foreground="Gray" />

                    <!-- O CAMPO MÁGICO DO LEITOR -->
                    <TextBlock Text="Código de Barras:" FontWeight="Bold" Margin="0,0,0,5" />
                    <TextBox x:Name="txtCodigoBarras" FontSize="24" FontWeight="Bold" Margin="0,0,0,0" Padding="10" KeyDown="txtCodigoBarras_KeyDown" >
                        <i:Interaction.Behaviors>
                            <localBehaviors:ApenasNumerosBehavior>
                            </localBehaviors:ApenasNumerosBehavior>
                        </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock Text="Para codigos digitado manualmente, aperte ENTER para confirmar" FontSize="12" Foreground="Gray" />

                    <!-- O Totalzão da Compra -->
                    <TextBlock Text="TOTAL DA COMPRA:" FontSize="18" FontWeight="Bold" Foreground="Gray" Margin="0,20,0,0"/>
                    <TextBlock Text="{Binding TotalCompra, StringFormat='{}R$ {0:N2}'}" FontSize="45" FontWeight="Black" Foreground="DarkGreen" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Desconto, StringFormat='{}Desconto Global: R$ {0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#E74C3C" Margin="0,0,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Acrescimo, StringFormat='{}Acréscimo Global: R$ {0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,0" HorizontalAlignment="Center"/>

                    <!-- Botões de Ação -->
                    <Button Content="Finalizar Compra (F4)" Height="60" FontSize="20" FontWeight="Bold" Background="LightGreen" Click="FinalizarCompra_Click"
                            ToolTip="Finalizar Compra e Ir para Pagamento (F4)"/>
                    <Button Content="Cancelar Venda (Esc)" Height="40" FontSize="16" FontWeight="Bold" Background="LightCoral" Margin="0,10,0,0" Click="CancelarCompra_Click"
                            ToolTip="Cancelar Venda Atual (Esc)"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="0,0,10,0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="CUPOM FISCAL / CARRINHO" FontSize="18" FontWeight="Bold" Margin="10" Foreground="Gray"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Carrinho}" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produto" Binding="{Binding Produto.Nome}" Width="*" />
                            <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="60" />
                            <DataGridTextColumn Header="V. Unit. (R$)" Binding="{Binding ValorUnitario, StringFormat={}{0:N2}}" Width="100" />
                            <DataGridTextColumn Header="Subtotal (R$)" Binding="{Binding Subtotal, StringFormat={}{0:N2}}" Width="100" />
                            <DataGridTextColumn x:Name="colDesconto" Header="Desconto (R$)" Binding="{Binding Desconto, StringFormat={}{0:N2}}" Width="100" />
                            <DataGridTextColumn Header="Acréscimo (R$)" Binding="{Binding Acrescimo, StringFormat={}{0:N2}}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>


    </Grid>
</UserControl>
