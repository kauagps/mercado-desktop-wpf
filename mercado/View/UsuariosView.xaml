<UserControl x:Class="mercado.View.UsuariosView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:mercado.View"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:localBehaviors="clr-namespace:mercado.Behaviors"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:model="clr-namespace:mercado.Model"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="TipoUsuarioValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:TipoUsuario"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--=========================================================================================================================-->
        <!-- CONTAINER Cadastrar USUÁRIOS -->
        <!--==============================-->
        <Border Grid.Row="0" Background="#f9f6f0" CornerRadius="5" Padding="10" Margin="0, 0, 0, 20">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  Direction="270"
                                  ShadowDepth="1"
                                  BlurRadius="10"
                                  Opacity="0.2"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <!--Titulo-->
                <TextBlock Grid.Row="0" Text="Cadastrar Usuário" FontSize="16" FontWeight="Bold" Margin="0, 0, 0, 10"/>

                <!--Nome e Tipo-->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0, 0, 0, 20">
                    <StackPanel Orientation="Horizontal" Margin="0, 0, 20, 0">
                        <TextBlock Text="* Nome:" VerticalAlignment="Center" Margin="0, 0, 10, 0"/>
                        <TextBox Width="200" Margin="0, 0, 10, 0"
                             Text="{Binding NovoUsuario.Nome, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Nome do usuário"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0, 0, 20, 0">
                        <TextBlock Text="* Tipo:" VerticalAlignment="Center" Margin="0, 0, 10, 0"/>
                        <ComboBox Width="150" Margin="0, 0, 10, 0"
                              ItemsSource="{Binding Source={StaticResource TipoUsuarioValues}}"
                              SelectedItem="{Binding NovoUsuario.Tipo, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Tipo de usuário"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0, 0, 20, 0">
                        <TextBlock Text="* Senha:" VerticalAlignment="Center" Margin="0, 0, 10, 0"/>
                        <PasswordBox x:Name="txtNovaSenha"
                                 Width="150" Margin="0, 0, 10, 0"
                                 ToolTip="Senha do usuário"/>
                    </StackPanel>
                </StackPanel>

                <!--Confirmação de Senha e Status Ativo-->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0, 0, 0, 20">
                    <StackPanel Orientation="Horizontal" Margin="0, 0, 20, 0">
                        <TextBlock Text="* Confirmar Senha:" VerticalAlignment="Center" Margin="0, 0, 10, 0"/>
                        <PasswordBox x:Name="txtConfirmarSenha"
                                 Width="150" Margin="0, 0, 10, 0"
                                 ToolTip="Confirme a senha"/>
                    </StackPanel>

                    <CheckBox Content="Usuário Ativo" 
                              IsChecked="{Binding NovoUsuario.Ativo, UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Center"
                              Margin="0, 0, 20, 0"/>
                </StackPanel>

                <!--Botao Adicionar Usuário-->
                <Grid Grid.Row="3" HorizontalAlignment="Stretch">
                    <Button Content="Adicionar Usuário" Width="180" 
                            HorizontalAlignment="Right"
                            Click="btnAdicionar_Click"></Button>
                </Grid>
            </Grid>
        </Border>

        <!--======================================================================================================================================-->
        <!-- CONTAINER TABELA DE USUÁRIOS -->
        <!--==============================-->
        <Border Grid.Row="1" Background="#f9f6f0" CornerRadius="5" Padding="10" Margin="0, 0, 0, 20">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                      Direction="270"
                      ShadowDepth="1"
                      BlurRadius="10"
                      Opacity="0.2"/>
            </Border.Effect>
            
            <Grid Margin="0, 20, 0, 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0, 0, 0, 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Lista de Usuários" FontSize="16" FontWeight="Bold" Margin="0, 0, 0, 10"/>

                    <!--Campo Buscar Usuário-->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 0, 0, 10">
                        <TextBlock Text="Buscar Usuário: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0, 0, 10, 0"/>
                        <TextBox Width="250" Padding="5"
                             Text="{Binding TextoBusca, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Digite o nome do usuário para buscar"/>
                    </StackPanel>
                </Grid>

                <!--Tabela de Usuários-->
                <DataGrid Grid.Row="1" ItemsSource="{Binding UsuariosLista}" AutoGenerateColumns="False" IsReadOnly="True" Background="#fcf8f2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120" />
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="12" Height="12" Margin="0,0,5,0" 
                                                 Fill="{Binding Ativo, Converter={StaticResource BoolToStatusColorConverter}}"/>
                                        <TextBlock Text="{Binding Ativo, Converter={StaticResource BoolToStatusTextConverter}}" 
                                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Ações" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!--Editar-->
                                        <Button Content="Editar" Width="70" Margin="2" Background="LightBlue"
                                        Command="{Binding DataContext.EditarUsuarioCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" />

                                        <!--Inativar/Ativar-->
                                        <Button Content="{Binding Ativo, Converter={StaticResource BoolToToggleTextConverter}}" Width="80" Margin="2" 
                                                Background="{Binding Ativo, Converter={StaticResource BoolToToggleBgConverter}}"
                                                Foreground="{Binding Ativo, Converter={StaticResource BoolToToggleFgConverter}}"
                                        Command="{Binding DataContext.InativarUsuarioCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" />

                                        <!--Excluir-->
                                        <Button Content="Excluir" Width="75" Margin="2" Background="LightCoral"
                                        Command="{Binding DataContext.ExcluirUsuarioCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding DataContext.PodeExcluir, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource UsuarioPodeExcluirConverter}}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <ToolTip.Content>
                                                        <TextBlock>
                                                            <Run Text="Excluir este usuário"/>
                                                            <Run Text=" (bloqueado se for último admin)" Foreground="Gray" FontStyle="Italic"/>
                                                        </TextBlock>
                                                    </ToolTip.Content>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--Rodape com paginação-->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 15, 0, 0">
                    <TextBlock Text="{Binding TotalItens, StringFormat='{}Total no banco: {0} itens'}" 
                       VerticalAlignment="Center" 
                       Margin="0,0,30,0" 
                       FontWeight="SemiBold" 
                       Foreground="Gray"/>

                    <TextBlock Text="Itens por página: " VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <ComboBox ItemsSource="{Binding OpcoesItensPorPagina}"
                              SelectedItem="{Binding ItensPorPagina, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Width="60" Margin="0,0,20,0" VerticalContentAlignment="Center"/>

                    <Button Content="&lt; Anterior" Command="{Binding PaginaAnteriorCommand}" Width="80" Margin="0,0,10,0"/>

                    <TextBlock Text="{Binding PaginaAtual, StringFormat='{}Página {0} de '}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPaginas}" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold"/>

                    <Button Content="Próxima >" Command="{Binding ProximaPaginaCommand}" Width="80"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
