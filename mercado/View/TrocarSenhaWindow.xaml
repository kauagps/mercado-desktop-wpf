<Window x:Class="mercado.View.TrocarSenhaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mercado.View"
        mc:Ignorable="d"
        Title="Troca de Senha Obrigatória" Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#fcf8f2"
        Style="{StaticResource MaterialDesignWindow}"
        KeyDown="Window_KeyDown">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="🔒" FontSize="36" HorizontalAlignment="Center"/>
            <TextBlock Text="Troca de senha obrigatória"
                       FontSize="20" FontWeight="Bold" Foreground="#2C3E50"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock x:Name="txtMensagem"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="Gray" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Formulário -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Nova senha" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtNovaSenha"
                         Margin="0,0,0,15"
                         Padding="10"
                         FontSize="14"
                         KeyDown="txtSenha_KeyDown"
                         ToolTip="Digite a nova senha"/>

            <TextBlock Text="Confirmar nova senha" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtConfirmarSenha"
                         Margin="0,0,0,10"
                         Padding="10"
                         FontSize="14"
                         KeyDown="txtSenha_KeyDown"
                         ToolTip="Repita a nova senha"/>

            <TextBlock Text="Mínimo de 8 caracteres, com pelo menos uma letra e um número."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>

            <TextBlock x:Name="txtErro"
                       Text=""
                       Foreground="Red"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,12,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Botões -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancelar"
                    Padding="14,6" Margin="0,0,8,0"
                    Click="btnCancelar_Click"/>
            <Button Content="Alterar senha"
                    Padding="14,6"
                    Background="#2C3E50" Foreground="White" BorderThickness="0"
                    Click="btnAlterar_Click"/>
        </StackPanel>
    </Grid>
</Window>
