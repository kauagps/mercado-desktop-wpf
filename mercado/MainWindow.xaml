<Window x:Class="mercado.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mercado"
        mc:Ignorable="d"
        xmlns:viewmodels="clr-namespace:mercado.ViewModel"
        xmlns:views="clr-namespace:mercado.View"
        Style="{StaticResource MaterialDesignWindow}"
        Title="Sistema Mercado" Height="600" Width="900">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:EstoqueViewModel}">
            <views:EstoqueView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PdvViewModel}">
            <views:PdvView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="#2C3E50" Height="50" Padding="10, 0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="ESTOQUE" Command="{Binding NavEstoqueCommand}"
                        Width="120" Height="35" Margin="0, 0, 10, 0"
                        Background="#34495E" Foreground="White" BorderThickness="0" Cursor="Hand"></Button>
                <Button Content="FRENTE DE CAIXA" Command="{Binding NavPdvCommand}"
                        Width="155" Height="35"
                        Background="#34495E" Foreground="White" BorderThickness="0" Cursor="Hand"></Button> 
            </StackPanel>
        </Border>
        
        <ContentControl Content="{Binding CurrentViewModel}" Margin="10"/>
    </DockPanel>
</Window>
